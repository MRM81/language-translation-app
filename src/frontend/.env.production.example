# Production frontend environment — AWS S3 + CloudFront + Elastic Beanstalk
#
# Copy this file to .env.production.local and set the real backend URL before building.
# Never commit .env.production.local — it is excluded by .gitignore.
#
# Build command:
#   VITE_API_BASE_URL=https://your-backend.elasticbeanstalk.com npm run build
#
# Or create .env.production.local with the real value and run:
#   npm run build
#
# Leave blank for same-origin deployment (frontend and backend on the same domain).
VITE_API_BASE_URL=https://your-backend.elasticbeanstalk.com
